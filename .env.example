# --- Gemini ---
# Server-side only. Never exposed to the browser. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Supabase ---
# Public — safe in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Used by trusted server code (webhooks, admin scripts) — never sent to the
# browser, never used inside a "use client" component or a client-invoked API route.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: RLS integration test (tests/rls-cross-user-access.test.ts) ---
# Only needed to run the live cross-user-access test; the rest of the suite runs without these.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_USER_A_JWT=
TEST_USER_B_JWT=
